# Local/private config goes in the include
[include]
  path = ~/.gitconfig.local

[core]
  excludesfile = ~/.gitignore
  pager = diffr | less -R
  editor = vim

[pull]
  rebase = false

[hub]
  protocol = https

[interactive]
  difffilter = diffr

[init]
  defaultBranch = master

[user]
  name = Emmanuel Hoffmann

[sequence]
  editor = vim

[credential "https://gitlab.myjungly.com"]
  helper = 
  helper = !/usr/bin/glab auth git-credential

[alias]
  merged = "!f() { target=${1:-main}; git fetch -q origin || return 1; if git merge-base --is-ancestor HEAD \"origin/$target\"; then echo \"Merged into $target\"; else echo \"Not merged into $target\"; fi; }; f"
